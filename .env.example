# 服务端口
PORT=3000

# 鉴权密钥（Bearer Token 或 X-Relay-Secret 头）
RELAY_SECRET=change-me-to-a-strong-secret

# 默认 bot id（/push/grokbot 别名目标），默认 task-os
# DEFAULT_BOT_ID=task-os

# 多 bot 配置：JSON 字符串，键为 bot id，值为 webhookUrl / webhookKey
# 也可复制 bots.example.json 为 data/bots.json 或通过 BOTS_CONFIG_PATH 指定路径
# BOTS_JSON={"task-os":{"webhookUrl":"https://example.com/hooks/task-os","webhookKey":"your-bearer-token"}}

# 可选：bots 配置文件路径（默认 DATA_DIR/bots.json）
# BOTS_CONFIG_PATH=/app/data/bots.json

# 可选：收到 /webhook/grokbot 后转发到此 URL
# FORWARD_URL=https://example.com/hook

# 可选：向后兼容的单 bot 推送（当 task-os 未在 BOTS_JSON / bots.json 中配置 webhookUrl 时生效）
# GROKBOT_WEBHOOK_URL=https://example.com/grokbot/inbound
# GROKBOT_WEBHOOK_KEY=your-cursor-automation-bearer-token
# GROKBOT_WEBHOOK_AUTH=  # 与 GROKBOT_WEBHOOK_KEY 等价，任选其一

# 数据目录（messages.jsonl 与默认 bots.json 路径）
# DATA_DIR=data
